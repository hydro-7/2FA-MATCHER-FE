{
  "openapi": "3.0.3",
  "info": {
    "title": "Group Travel Matcher API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id",
        "description": "Traveller ID, e.g. T-001"
      }
    }
  },
  "paths": {
    "/api/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Cities, interests, home cities, date window, group size and rule thresholds",
        "responses": {
          "200": {
            "description": "Form options"
          }
        }
      }
    },
    "/api/travellers": {
      "post": {
        "tags": [
          "Travellers"
        ],
        "summary": "Sign up (M1)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 18,
                    "maximum": 100
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "FEMALE",
                      "MALE"
                    ]
                  },
                  "homeCity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "homeAirport": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "genderPreference": {
                    "type": "string",
                    "enum": [
                      "ANY",
                      "SAME_GENDER"
                    ]
                  },
                  "interests": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 16
                  }
                },
                "required": [
                  "name",
                  "gender",
                  "homeCity",
                  "genderPreference",
                  "interests"
                ],
                "additionalProperties": false
              },
              "example": {
                "name": "Priya Shah",
                "age": 26,
                "gender": "FEMALE",
                "homeCity": "Mumbai",
                "homeAirport": "BOM",
                "genderPreference": "SAME_GENDER",
                "interests": [
                  "TEMPLES",
                  "STREET_FOOD",
                  "ADVENTURE"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created traveller"
          },
          "400": {
            "description": "Validation failed"
          }
        }
      },
      "get": {
        "tags": [
          "Travellers"
        ],
        "summary": "List all travellers",
        "responses": {
          "200": {
            "description": "Travellers"
          }
        }
      }
    },
    "/api/travellers/{id}": {
      "get": {
        "tags": [
          "Travellers"
        ],
        "summary": "Traveller profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "T-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Traveller"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Travellers"
        ],
        "summary": "Current traveller (from X-User-Id)",
        "security": [
          {
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current traveller"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          }
        }
      }
    },
    "/api/groups": {
      "post": {
        "tags": [
          "Groups"
        ],
        "summary": "Create a group post (M2). The caller becomes owner and first member.",
        "security": [
          {
            "userId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checkIn": {
                    "type": "string"
                  },
                  "checkOut": {
                    "type": "string"
                  },
                  "maxSize": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "budgetInr": {
                    "type": "integer",
                    "exclusiveMinimum": true,
                    "minimum": 0
                  },
                  "itinerary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "name",
                  "city",
                  "checkIn",
                  "checkOut",
                  "maxSize",
                  "budgetInr",
                  "itinerary"
                ],
                "additionalProperties": false
              },
              "example": {
                "name": "Kyoto Spring Temples",
                "city": "Kyoto",
                "checkIn": "2027-04-10",
                "checkOut": "2027-04-15",
                "maxSize": 3,
                "budgetInr": 60000,
                "itinerary": "Fushimi Inari at sunrise, Nishiki Market lunch, Gion walk, photo day in Arashiyama."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created group with owner, members, memberCount and seatsLeft"
          },
          "400": {
            "description": "Validation failed, or city/dates outside the data (OUT_OF_DATA_RANGE)"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          }
        }
      }
    },
    "/api/groups/mine": {
      "get": {
        "tags": [
          "Groups"
        ],
        "summary": "Groups the caller belongs to, with role, memberCount and pendingRequestCount (owner only)",
        "security": [
          {
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "My groups"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          }
        }
      }
    },
    "/api/groups/{id}": {
      "get": {
        "tags": [
          "Groups"
        ],
        "summary": "Group details with owner, members, seatsLeft and the caller’s join request status (X-User-Id optional)",
        "security": [
          {
            "userId": []
          },
          {

          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          }
        ],
        "responses": {
          "200": {
            "description": "Group"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/groups/{id}/hotels": {
      "get": {
        "tags": [
          "Group Page"
        ],
        "summary": "Hotel options for the group’s city and dates with per-member cost (M6)",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "price",
                "rating",
                "stars"
              ],
              "default": "price"
            },
            "description": "Sort order"
          },
          {
            "name": "minStars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "description": "Minimum hotel stars"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "description": "Page size"
          },
          {
            "name": "preview",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "full"
              ]
            },
            "description": "Split for maxSize members instead of the current count"
          }
        ],
        "responses": {
          "200": {
            "description": "Options with rooms, totalInr, perMemberInr and membersUsed"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not a group member"
          },
          "404": {
            "description": "Group not found"
          }
        }
      }
    },
    "/api/groups/{id}/saved": {
      "get": {
        "tags": [
          "Group Page"
        ],
        "summary": "Saved options grouped by room with savedBy and alignment, re-priced for the current member count",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          }
        ],
        "responses": {
          "200": {
            "description": "Saved options, most-saved first"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not a group member"
          },
          "404": {
            "description": "Group not found"
          }
        }
      },
      "post": {
        "tags": [
          "Group Page"
        ],
        "summary": "Save a room option for the caller",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roomId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "roomId"
                ],
                "additionalProperties": false
              },
              "example": {
                "roomId": "RM-KYO-001-A"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved option with server-side quote"
          },
          "400": {
            "description": "Room not in the group’s city"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not a group member"
          },
          "404": {
            "description": "Group not found"
          },
          "409": {
            "description": "Already saved, room unavailable, or group already booked"
          }
        }
      }
    },
    "/api/groups/{id}/saved/{roomId}": {
      "delete": {
        "tags": [
          "Group Page"
        ],
        "summary": "Remove the caller’s saved option",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          },
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "RM-KYO-001-A"
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not a group member"
          },
          "404": {
            "description": "Group or saved option not found"
          },
          "409": {
            "description": "Group already booked"
          }
        }
      }
    },
    "/api/groups/{id}/booking": {
      "get": {
        "tags": [
          "Group Page"
        ],
        "summary": "The group’s booking with hotel, room and per-member split",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          }
        ],
        "responses": {
          "200": {
            "description": "Booking"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not a group member"
          },
          "404": {
            "description": "Group or booking not found"
          }
        }
      },
      "post": {
        "tags": [
          "Group Page"
        ],
        "summary": "Finalize the booking (any member). Locks the group as BOOKED.",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roomId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "roomId"
                ],
                "additionalProperties": false
              },
              "example": {
                "roomId": "RM-KYO-001-A"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking with BK- id, totalInr and perMemberInr"
          },
          "400": {
            "description": "Room not in the group’s city"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not a group member"
          },
          "404": {
            "description": "Group not found"
          },
          "409": {
            "description": "Group already booked, or room unavailable"
          }
        }
      }
    },
    "/api/matches/search": {
      "post": {
        "tags": [
          "Matches"
        ],
        "summary": "Search groups (M3/M4). Saves the search, returns ranked matches (all 6 rules pass) and near misses (exactly 1 rule fails, with a suggestion). Gender comes from the profile; genderPreference defaults to the profile.",
        "security": [
          {
            "userId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "homeCity": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checkIn": {
                    "type": "string"
                  },
                  "checkOut": {
                    "type": "string"
                  },
                  "budgetInr": {
                    "type": "integer",
                    "exclusiveMinimum": true,
                    "minimum": 0
                  },
                  "interests": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 16
                  },
                  "genderPreference": {
                    "type": "string",
                    "enum": [
                      "ANY",
                      "SAME_GENDER"
                    ]
                  }
                },
                "required": [
                  "city",
                  "checkIn",
                  "checkOut",
                  "budgetInr",
                  "interests"
                ],
                "additionalProperties": false
              },
              "example": {
                "homeCity": "Mumbai",
                "city": "Kyoto",
                "checkIn": "2027-04-09",
                "checkOut": "2027-04-16",
                "budgetInr": 62000,
                "interests": [
                  "TEMPLES",
                  "STREET_FOOD",
                  "ADVENTURE"
                ],
                "genderPreference": "SAME_GENDER"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "searchId, criteria, matches and nearMisses sorted by score desc, shared nights desc, check-in asc, group id asc"
          },
          "400": {
            "description": "Validation failed, unknown interests, or city/dates outside the data (OUT_OF_DATA_RANGE)"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          }
        }
      }
    },
    "/api/groups/{id}/requests": {
      "post": {
        "tags": [
          "Requests"
        ],
        "summary": "Express interest in a group (M5). The server re-checks all 6 rules against the saved search.",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "searchId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "searchId"
                ],
                "additionalProperties": false
              },
              "example": {
                "searchId": "S-0123456789ab"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PENDING join request"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Search belongs to another traveller"
          },
          "404": {
            "description": "Group or search not found"
          },
          "409": {
            "description": "Already a member, group not open, or a request already exists (details.status)"
          },
          "422": {
            "description": "RULE_NOT_MET: details lists every rule with pass/detail"
          }
        }
      },
      "get": {
        "tags": [
          "Requests"
        ],
        "summary": "Owner only: join requests with seeker profile, search criteria and rules re-evaluated now",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "G-01"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "PENDING",
                "APPROVED",
                "REJECTED"
              ],
              "default": "PENDING"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requests ordered by createdAt asc, id asc"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not the owner"
          },
          "404": {
            "description": "Group not found"
          }
        }
      }
    },
    "/api/requests/mine": {
      "get": {
        "tags": [
          "Requests"
        ],
        "summary": "The caller’s join requests with group name, city, dates and status",
        "security": [
          {
            "userId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Requests ordered by createdAt desc, id asc"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          }
        }
      }
    },
    "/api/requests/{requestId}": {
      "patch": {
        "tags": [
          "Requests"
        ],
        "summary": "Owner approves or rejects a PENDING request. Approve adds the seeker as a member in one transaction.",
        "security": [
          {
            "userId": []
          }
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "R-0123456789ab"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "APPROVE",
                      "REJECT"
                    ]
                  }
                },
                "required": [
                  "action"
                ],
                "additionalProperties": false
              },
              "example": {
                "action": "APPROVE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated request with memberCount and seatsLeft"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Missing or unknown X-User-Id"
          },
          "403": {
            "description": "Caller is not the owner"
          },
          "404": {
            "description": "Request not found"
          },
          "409": {
            "description": "Request already decided, group not open, or group is full"
          }
        }
      }
    }
  }
}